{
  // Cloudflare Workers (Static Assets) 배포 설정.
  // 대시보드 Build 설정: Build command = `npm run build`, Deploy command = `npx wrangler deploy`
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kimerin",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
